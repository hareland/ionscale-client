{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "git": {
    "requireCleanWorkingDir": true,
    "requireBranch": "main",
    "commitMessage": "chore(release): v${version}",
    "tagName": "ionscale-client${version}",
    "tagAnnotation": "ionscale-client${version}",
    "push": true
  },
  "github": {
    "release": true,
    "releaseName": "ionscale-client${version}"
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "after:bump": "pnpm run build --if-present",
    "after:release": "bash ./scripts/npm-publish.sh"
  }
}
